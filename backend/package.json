{
  "name": "privatehire-be",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared backend (Express + TypeScript + MySQL) for the PrivateHire Cars customer app and Staff Portal",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:reset": "tsx scripts/db-reset.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "db:init": "tsx scripts/db-init.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
