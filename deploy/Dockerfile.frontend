# Production frontend: build the customer app + Staff Portal, then serve the static files with Caddy.
# Stage 1 — build with Node
FROM node:24-alpine AS build
WORKDIR /src
COPY app/package*.json app/
RUN cd app && npm ci --no-audit --no-fund
COPY web/package*.json web/
RUN cd web && npm ci --no-audit --no-fund
COPY app app
COPY web web
# The Staff Portal reuses the backend's validation rules (same messages in browser and server).
COPY backend/src/validation backend/src/validation
RUN cd app && npm run build && cd ../web && npm run build

# Stage 2 — only Caddy + static files (no Node, no source code)
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/app/dist /srv/app
COPY --from=build /src/web/dist /srv/web
